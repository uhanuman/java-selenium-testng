<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE suite SYSTEM "https://testng.org/testng-1.0.dtd">
<suite name="demo Test Automation Architect Java Selenium TestNG Suite">

    <listeners>
        <listener class-name="com.demo.prep.observer.TestListener"/>
    </listeners>

    <test name="UI Pattern Tests">
        <listeners>
            <listener class-name="com.demo.prep.retry.RetryAnnotationTransformer"/>
        </listeners>
        <classes>
            <class name="com.demo.prep.tests.PageObjectModelTest"/>
            <class name="com.demo.prep.tests.ScreenplayPatternTest"/>
            <class name="com.demo.prep.tests.FactoryPatternTest"/>
            <class name="com.demo.prep.tests.StrategyPatternTest"/>
            <class name="com.demo.prep.tests.FacadePatternTest"/>
            <class name="com.demo.prep.tests.AllPatternsIntegratedTest"/>
        </classes>
    </test>

    <test name="Unit and API Tests">
        <classes>
            <class name="com.demo.prep.tests.BuilderPatternTest"/>
            <class name="com.demo.prep.tests.SingletonPatternTest"/>
            <class name="com.demo.prep.tests.RestAssuredApiTest"/>
        </classes>
    </test>

</suite>